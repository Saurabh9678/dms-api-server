APP_ENV=development
APP_PORT=8080
DB_URL=postgres://postgres:postgres@localhost:5432/dms?sslmode=disable
AUTH_ACCESS_TOKEN_SECRET=development-secret-change-me
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_MAX_ATTEMPTS=5

# Storage (local default; set STORAGE_PROVIDER=gcs to use GCS)
STORAGE_PROVIDER=local
STORAGE_BASE_PATH=./uploads
GCS_BUCKET_NAME=dms-dev-assets
STORAGE_SIGNED_URL_TTL_SECONDS=3600
