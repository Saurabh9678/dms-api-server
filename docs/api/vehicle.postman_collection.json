        {
          "name": "Add Vehicle Expense",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Platform",
                "value": "web",
                "description": "Required: web | ios_mobile | android_mobile | desktop"
              },
              {
                "key": "X-Device-Id",
                "value": "device-001",
                "description": "Required: non-empty device identifier"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "description": "Required: JWT access token"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"repair\",\n  \"amount\": 5000.00,\n  \"paid_to\": \"City Motors\",\n  \"description\": \"Engine oil change and brake pad replacement\",\n  \"date\": \"2024-03-15T10:00:00Z\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/vehicle/:id/expense",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "vehicle",
                ":id",
                "expense"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "1",
                  "description": "Vehicle ID"
                }
              ]
            },
            "description": "Add an expense record to a vehicle. Requires showroom membership. Type must be one of: repair, service, insurance, tax, inspection, cleaning, documentation, other."
