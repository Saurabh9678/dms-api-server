            {
              "name": "400 Bad Request",
              "status": "Bad Request",
              "code": 400,
              "body": "{\n  \"success\": false,\n  \"error\": {\n    \"code\": \"INVALID_REQUEST\",\n    \"message\": \"invalid request\"\n  }\n}"
            }
          ]
        },
        {
          "name": "List Vehicles by Category",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Platform",
                "value": "web",
                "description": "Required: web | ios_mobile | android_mobile | desktop"
              },
              {
                "key": "X-Device-Id",
                "value": "device-001",
                "description": "Required: non-empty device identifier"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "description": "Required: JWT access token"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/vehicle/listing?showroom_id=1&page=1&limit=20",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "vehicle",
                "listing"
              ],
              "query": [
                {
                  "key": "showroom_id",
                  "value": "1",
                  "description": "Required: numeric showroom ID. Caller must be a member of this showroom."
                },
                {
                  "key": "status",
                  "value": "",
                  "description": "Filter by status (repeatable). Values: garage, inspection, ready_for_sale, sold. Default: all statuses",
                  "disabled": true
                },
                {
                  "key": "type",
                  "value": "",
                  "description": "Filter by vehicle type (repeatable). Values: car, bike, scooty. Default: all",
                  "disabled": true
                },
                {
                  "key": "min_price",
                  "value": "",
                  "description": "Minimum price_tag filter",
                  "disabled": true
                },
                {
                  "key": "max_price",
                  "value": "",
                  "description": "Maximum price_tag filter",
                  "disabled": true
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number (min 1)"
                },
                {
                  "key": "limit",
                  "value": "20",
                  "description": "Items per page (1\u2013100)"
                }
              ]
            },
            "description": "List vehicles in a showroom grouped by category. Requires showroom_id. Category tallies: available_count (ready_for_sale), repair_count (garage+inspection), sold_count (sold) always cover all statuses; total/dead_stock_count respect status filter. Each vehicle current_status is a string."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"vehicle listing\",\n  \"data\": {\n    \"cars\": {\n      \"total\": 2,\n      \"page\": 1,\n      \"limit\": 20,\n      \"vehicles\": [\n        {\n          \"id\": 1,\n          \"vehicle_type\": \"car\",\n          \"manufacturer\": \"Toyota\",\n          \"model\": \"Camry\",\n          \"variant\": \"LE\",\n          \"color\": \"Black\",\n          \"year_of_manufacture\": 2020,\n          \"rto_code\": \"KA-01\",\n          \"registration_number\": \"KA01AB1234\",\n          \"registration_state\": \"Karnataka\",\n          \"usage_km\": 50000,\n          \"fuel_type\": \"petrol\",\n          \"transmission_type\": \"manual\",\n          \"current_status\": \"ready_for_sale\",\n          \"pricing\": {\n            \"buying_price\": 200000,\n            \"price_tag\": 350000,\n            \"currency\": \"inr\",\n            \"tagged_at\": \"2024-01-01T00:00:00Z\"\n          },\n          \"created_at\": \"2024-01-01T00:00:00Z\",\n          \"updated_at\": \"2024-01-01T00:00:00Z\",\n          \"images\": {\n            \"front\": [\n              {\n                \"id\": 12,\n                \"url\": \"https://storage.googleapis.com/bucket/front.jpg?X-Goog-Signature=...\"\n              }\n            ],\n            \"interior\": [\n              {\n                \"id\": 13,\n                \"url\": \"https://storage.googleapis.com/bucket/interior.jpg?X-Goog-Signature=...\"\n              }\n            ]\n          },\n          \"is_dead_stock\": true\n        }\n      ],\n      \"dead_stock_count\": 1,\n      \"available_count\": 1,\n      \"repair_count\": 0,\n      \"sold_count\": 1\n    },\n    \"bikes\": {\n      \"total\": 0,\n      \"page\": 1,\n      \"limit\": 20,\n      \"vehicles\": []\n    },\n    \"scooties\": {\n      \"total\": 0,\n      \"page\": 1,\n      \"limit\": 20,\n      \"vehicles\": []\n    }\n  }\n}"
            },
            {
              "name": "400 Bad Request",
              "status": "Bad Request",
              "code": 400,
              "body": "{\n  \"success\": false,\n  \"error\": {\n    \"code\": \"INVALID_REQUEST\",\n    \"message\": \"invalid request\"\n  }\n}"
            },
            {
              "name": "403 Forbidden",
              "status": "Forbidden",
              "code": 403,
              "body": "{\n  \"success\": false,\n  \"error\": {\n    \"code\": \"FORBIDDEN\",\n    \"message\": \"forbidden\"\n  }\n}"
            }
          ]
        },
        {
          "name": "Public Showroom Vehicle Listing",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Platform",
                "value": "web",
                "description": "Required: web | ios_mobile | android_mobile | desktop"
              },
              {
                "key": "X-Device-Id",
                "value": "device-001",
                "description": "Required: non-empty device identifier"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/vehicle/public-listing?showroom_id=1&page=1&limit=20&sort_by=price_asc",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "vehicle",
                "public-listing"
              ],
              "query": [
                {
                  "key": "showroom_id",
                  "value": "1",
                  "description": "Required: showroom ID to scope the listing"
                },
                {
                  "key": "type",
                  "value": "",
                  "description": "Filter by vehicle type (repeatable). Values: car, bike, scooty. Default: all",
                  "disabled": true
                },
                {
                  "key": "min_price",
                  "value": "",
                  "description": "Minimum price_tag filter",
                  "disabled": true
                },
                {
                  "key": "max_price",
                  "value": "",
                  "description": "Maximum price_tag filter",
                  "disabled": true
                },
                {
                  "key": "sort_by",
                  "value": "price_asc",
                  "description": "Sort order. Values: price_asc, price_desc. Default: price_asc"
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number (min 1)"
                },
                {
                  "key": "limit",
                  "value": "20",
                  "description": "Items per page (1\u2013100)"
                }
              ]
            },
            "description": "Public showroom vehicle listing (ready_for_sale only). No auth. Each vehicle includes price_tag/currency and images: label \u2192 [{id, url}] signed URLs; empty object when none."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"vehicle listing\",\n  \"data\": {\n    \"cars\": {\n      \"total\": 1,\n      \"page\": 1,\n      \"limit\": 20,\n      \"vehicles\": [\n        {\n          \"id\": 1,\n          \"vehicle_type\": \"car\",\n          \"manufacturer\": \"Toyota\",\n          \"model\": \"Camry\",\n          \"variant\": \"LE\",\n          \"color\": \"Black\",\n          \"year_of_manufacture\": 2020,\n          \"rto_code\": \"KA-01\",\n          \"registration_number\": \"KA01AB1234\",\n          \"registration_state\": \"Karnataka\",\n          \"usage_km\": 50000,\n          \"fuel_type\": \"petrol\",\n          \"transmission_type\": \"manual\",\n          \"price_tag\": 350000,\n          \"currency\": \"inr\",\n          \"created_at\": \"2024-01-01T00:00:00Z\",\n          \"updated_at\": \"2024-01-01T00:00:00Z\",\n          \"images\": {\n            \"front\": [\n              {\n                \"id\": 12,\n                \"url\": \"https://storage.googleapis.com/bucket/front.jpg?X-Goog-Signature=...\"\n              }\n            ]\n          }\n        }\n      ]\n    },\n    \"bikes\": null,\n    \"scooties\": null\n  }\n}"
            },
            {
              "name": "400 Bad Request - Missing showroom_id",
              "status": "Bad Request",
              "code": 400,
              "body": "{\n  \"success\": false,\n  \"error\": {\n    \"code\": \"INVALID_REQUEST\",\n    \"message\": \"invalid request\"\n  }\n}"
            }
          ]
        },
        {
          "name": "Get Vehicle",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "description": "Required: JWT access token"
              },
              {
                "key": "X-Platform",
                "value": "web",
                "description": "Required: web | ios_mobile | android_mobile | desktop"
