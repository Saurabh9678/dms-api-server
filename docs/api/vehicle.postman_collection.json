            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "body": "{\n  \"success\": true,\n  \"message\": \"expense added\",\n  \"data\": {\n    \"id\": 1,\n    \"vehicle_id\": 1,\n    \"type\": \"repair\",\n    \"amount\": 5000.00,\n    \"paid_to\": \"City Motors\",\n    \"description\": \"Engine oil change and brake pad replacement\",\n    \"date\": \"2024-03-15T10:00:00Z\",\n    \"created_at\": \"2024-03-15T10:00:00Z\"\n  }\n}"
