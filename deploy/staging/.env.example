# PostgreSQL
POSTGRES_USER=infiniour
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=dms

# Application
APP_ENV=staging
APP_PORT=8080

# Auth
AUTH_ACCESS_TOKEN_SECRET=CHANGE_ME_RANDOM_64_CHAR_SECRET
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_MAX_ATTEMPTS=5

# Providers
OTP_PROVIDER=

# Storage — use GCS in staging
STORAGE_PROVIDER=gcs
GCS_BUCKET_NAME=dms-dev-assets
STORAGE_SIGNED_URL_TTL_SECONDS=3600
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcs-sa.json
# Optional override for the host path mounted in docker-compose.yml:
# GCS_SA_KEY_PATH=/opt/infiniour/secrets/gcs-sa.json
